# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in the values.
#  Never commit .env.local — it holds your mailbox password.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, sitemap, links in emails)
NEXT_PUBLIC_SITE_URL=https://worldwideschoolhouse.com

# ── Zoho Mail SMTP ───────────────────────────────────────────
# Host depends on your Zoho data centre / plan:
#   smtp.zoho.com      → free / personal accounts (US DC)
#   smtppro.zoho.com   → paid org accounts with your own domain (US DC)
#   smtp.zoho.eu / smtppro.zoho.eu → EU data centre
#   smtp.zoho.in / smtppro.zoho.in → India data centre
SMTP_HOST=smtppro.zoho.com

# 465 = SSL (recommended)   587 = STARTTLS
SMTP_PORT=465

# The full Zoho mailbox address, e.g. hello@worldwideschoolhouse.com
SMTP_USER=hello@worldwideschoolhouse.com

# If 2FA is on (it should be): Zoho → My Account → Security →
# App Passwords → generate one and paste it here.
SMTP_PASS=

# "From" address — must be SMTP_USER or a verified alias in Zoho
MAIL_FROM="Worldwide Schoolhouse <hello@worldwideschoolhouse.com>"

# Where contact-form messages are delivered (comma-separate for several)
CONTACT_TO=hello@worldwideschoolhouse.com

# Send an automatic "we got your message" reply to the sender (true/false)
CONTACT_AUTOREPLY=true
